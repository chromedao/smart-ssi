<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to a development issuer on the local network (e.g. the Mac's Wi-Fi IP).
     Release builds use src/main/res/xml/network_security_config.xml, which only allows the emulator host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
